{
  "description": "code-tutor: per-prompt mode context, state changes for /code-tutor:* commands and the write guard",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^code-tutor:",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-command-expand.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-prompt-submit.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-pre-tool-use.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
